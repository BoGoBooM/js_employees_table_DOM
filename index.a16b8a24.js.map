var headers = document.querySelectorAll("thead th");
var tbody = document.querySelector("tbody");
var currentSortColumn = null;
var sortDirection = "asc";
headers.forEach(function(header, index) {
    header.addEventListener("click", function(e) {
        var rows = Array.from(document.querySelectorAll("tbody tr"));
        var sortedRows = rows.map(function(row) {
            var value = index === 4 ? row.children[index].textContent.trim().replaceAll(",", "").replace("$", "") : row.children[index].textContent.trim();
            return {
                element: row,
                value: value
            };
        });
        if (currentSortColumn === index) sortDirection = sortDirection === "asc" ? "desc" : "asc";
        else {
            currentSortColumn = index;
            sortDirection = "asc";
        }
        sortedRows.sort(function(a, b) {
            if (!isNaN(Number(a.value))) return sortDirection === "asc" ? Number(a.value) - Number(b.value) : Number(b.value) - Number(a.value);
            else return sortDirection === "asc" ? a.value.localeCompare(b.value) : b.value.localeCompare(a.value);
        });
        tbody.innerHTML = "";
        sortedRows.forEach(function(obj) {
            return tbody.appendChild(obj.element);
        });
    });
});
